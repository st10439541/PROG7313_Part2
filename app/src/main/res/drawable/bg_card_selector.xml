<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- checked = sage background + green border -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <solid android:color="@color/sage_light"/>
            <stroke android:width="2dp" android:color="@color/forest"/>
        </shape>
    </item>
    <!-- unchecked = white background + thin linen border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <solid android:color="@color/white"/>
            <stroke android:width="1.5dp" android:color="@color/linen"/>
        </shape>
    </item>
</selector>
<?xml version="1.0" encoding="utf-8"?>
<!--
    item_recent_expense.xml
    SPENDID — Recent Expense Item
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/expenseIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_circle_green"
        android:gravity="center"
        android:text="🍔"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/expenseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lato_bold"
            android:text="Lunch at restaurant"
            android:textColor="@color/bark"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/expenseMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/lato_regular"
            android:text="Food · Mar 10"
            android:textColor="@color/brown_light"
            android:textSize="11sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/expenseAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lato_bold"
        android:text="R 120"
        android:textColor="@color/bark"
        android:textSize="14sp" />

</LinearLayout>